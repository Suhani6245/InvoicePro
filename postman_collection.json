{
  "info": {
    "name": "InvoicePro API",
    "description": "Complete API collection for InvoicePro — Intelligent Billing & Invoice Management System. Set the `baseUrl` variable, run Login first (it auto-saves the token), then everything else just works.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "invoiceNumber", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register First Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@invoicepro.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@invoicepro.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeMe123!\",\n  \"newPassword\": \"NewPassword456!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('customerId', json.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav@meltech.example.com\",\n  \"phone\": \"9820011223\",\n  \"address\": \"Andheri East, Mumbai, MH\",\n  \"gstNumber\": \"27AAMFM1234A1Z5\",\n  \"companyName\": \"Meltech Solutions\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"] }
          }
        },
        {
          "name": "List / Search Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?search=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Customer By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9820099999\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Delete Customer (Soft Delete)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "customers", "{{customerId}}"] }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('invoiceId', json.data._id);",
                  "  pm.collectionVariables.set('invoiceNumber', json.data.invoiceNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"{{customerId}}\",\n  \"dueDate\": \"2026-08-15\",\n  \"items\": [\n    { \"productName\": \"Web Design Services\", \"quantity\": 1, \"unitPrice\": 15000 },\n    { \"productName\": \"Server Hosting (Monthly)\", \"quantity\": 3, \"unitPrice\": 3500 }\n  ],\n  \"gstPercent\": 18,\n  \"discountPercent\": 0,\n  \"notes\": \"Thanks for your business!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
          }
        },
        {
          "name": "Create Invoice (Force, bypass duplicate warning)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"{{customerId}}\",\n  \"dueDate\": \"2026-08-15\",\n  \"items\": [\n    { \"productName\": \"Web Design Services\", \"quantity\": 1, \"unitPrice\": 15000 }\n  ],\n  \"forceCreate\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
          }
        },
        {
          "name": "List Invoices (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/invoices?status=&customer=&search=&dateFrom=&dateTo=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"],
              "query": [
                { "key": "status", "value": "" },
                { "key": "customer", "value": "" },
                { "key": "search", "value": "" },
                { "key": "dateFrom", "value": "" },
                { "key": "dateTo", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Invoice By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Update Invoice",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"discountPercent\": 5\n}" },
            "url": { "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Delete Invoice (Soft Delete)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "{{invoiceId}}"] }
          }
        },
        {
          "name": "Download Invoice PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/pdf", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "{{invoiceId}}", "pdf"] }
          }
        },
        {
          "name": "Email Invoice to Customer",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/send-email", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "{{invoiceId}}", "send-email"] }
          }
        },
        {
          "name": "Public: Get Invoice for Payment (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/invoices/pay/{{invoiceNumber}}", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "pay", "{{invoiceNumber}}"] }
          }
        },
        {
          "name": "Public: Pay Invoice via QR (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/invoices/pay/{{invoiceNumber}}", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "pay", "{{invoiceNumber}}"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Record Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.payment && json.data.payment._id) {",
                  "  pm.collectionVariables.set('paymentId', json.data.payment._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice\": \"{{invoiceId}}\",\n  \"amount\": 5000,\n  \"paymentMethod\": \"UPI\",\n  \"transactionId\": \"TXN123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments", "host": ["{{baseUrl}}"], "path": ["api", "payments"] }
          }
        },
        {
          "name": "List Payments (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments?invoice=&customer=&paymentMethod=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"],
              "query": [
                { "key": "invoice", "value": "" },
                { "key": "customer", "value": "" },
                { "key": "paymentMethod", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Payment By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "dashboard"] }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "AI Spending Insights",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/analytics/insights", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "insights"] }
          }
        },
        {
          "name": "All Customers Reliability",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/analytics/reliability", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "reliability"] }
          }
        },
        {
          "name": "Single Customer Reliability (recomputes)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/analytics/reliability/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "reliability", "{{customerId}}"] }
          }
        },
        {
          "name": "Recalculate All Reliability Scores",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/analytics/reliability/recalculate", "host": ["{{baseUrl}}"], "path": ["api", "analytics", "reliability", "recalculate"] }
          }
        }
      ]
    },
    {
      "name": "Activity Logs",
      "item": [
        {
          "name": "List Activity Logs (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/activity-logs?action=&search=&page=1&limit=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity-logs"],
              "query": [
                { "key": "action", "value": "" },
                { "key": "search", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Distinct Action Types",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/activity-logs/actions", "host": ["{{baseUrl}}"], "path": ["api", "activity-logs", "actions"] }
          }
        }
      ]
    },
    {
      "name": "Decision Engine",
      "item": [
        {
          "name": "Get Recommendations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/decisions", "host": ["{{baseUrl}}"], "path": ["api", "decisions"] }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    }
  ]
}
